[Unit]
Description=Indi AllSky coordinated recovery

[Service]
Type=oneshot
EnvironmentFile=%ALLSKY_ETC%/indi-allsky.env
WorkingDirectory=%ALLSKY_DIRECTORY%
ExecStart=%ALLSKY_DIRECTORY%/virtualenv/indi-allsky/bin/python3 misc/automation_recovery.py --config "%ALLSKY_ETC%/flask.json"
TimeoutStartSec=10min
UMask=0077
